@using Nop.Data
@model AppSettingsModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DataConfigModel.ConnectionString" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DataConfigModel.ConnectionString" />
            <span asp-validation-for="DataConfigModel.ConnectionString"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DataConfigModel.DataProvider" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="DataConfigModel.DataProvider" asp-items="Model.DataConfigModel.DataProviderTypeValues" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DataConfigModel.SQLCommandTimeout" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DataConfigModel.SQLCommandTimeout" />
            <span asp-validation-for="DataConfigModel.SQLCommandTimeout"></span>
        </div>
    </div>
    @if(Model.DataConfigModel.DataProvider == (int)DataProviderType.SqlServer)
    {
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.WithNoLock" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.WithNoLock" />
                <span asp-validation-for="DataConfigModel.WithNoLock"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.MaxPoolSize" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.MaxPoolSize" />
                <span asp-validation-for="DataConfigModel.MaxPoolSize"></span>
                <span class="text-muted">@T("Admin.Configuration.AppSettings.Data.MaxPoolSize.Hint")</span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.MinPoolSize" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.MinPoolSize" />
                <span asp-validation-for="DataConfigModel.MinPoolSize"></span>
                <span class="text-muted">@T("Admin.Configuration.AppSettings.Data.MinPoolSize.Hint")</span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.ConnectionLifetime" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.ConnectionLifetime" />
                <span asp-validation-for="DataConfigModel.ConnectionLifetime"></span>
                <span class="text-muted">@T("Admin.Configuration.AppSettings.Data.ConnectionLifetime.Hint")</span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.MultipleActiveResultSets" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.MultipleActiveResultSets" />
                <span asp-validation-for="DataConfigModel.MultipleActiveResultSets"></span>
                <span class="text-muted">@T("Admin.Configuration.AppSettings.Data.MultipleActiveResultSets.Hint")</span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="DataConfigModel.MultiSubnetFailover" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="DataConfigModel.MultiSubnetFailover" />
                <span asp-validation-for="DataConfigModel.MultiSubnetFailover"></span>
                <span class="text-muted">@T("Admin.Configuration.AppSettings.Data.MultiSubnetFailover.Hint")</span>
            </div>
        </div>
    }
</div>